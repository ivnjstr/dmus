# Environment variables this site reads. Copy to .env.local for local development and fill in the
# values there; .env.local is git-ignored. Never put real values in this file.

# Contact form email (see README, "Contact form email").
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=

# TEMPORARY maintenance mode (see proxy.ts). "true" shows only the maintenance page; anything else
# shows the site as normal.
MAINTENANCE_MODE=false
# Optional owner preview while maintenance mode is on: visit any URL with ?preview=<this value> to
# see the real site (?preview=off to stop). Use a long random string; leave empty to disable.
MAINTENANCE_BYPASS_SECRET=
